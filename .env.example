# Copy to .env (gitignored). Never commit real values.

# Market data provider for the gateway: yahoo | alpaca | polygon | finnhub
TRADE_DATA_PROVIDER=yahoo
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Anthropic key used ONLY by the Trader agent process (trader/)
ANTHROPIC_API_KEY=
TRADER_MODEL=claude-opus-5-5

# Local ports (see docs/ARCHITECTURE.md §9)
TRADE_GATEWAY_PORT=8787
TRADE_MCP_PORT=8788
TRADE_WEB_PORT=5173
# web/ dev proxy target and browser-side gateway origin ("" = same-origin via the proxy)
TRADE_GATEWAY_URL=http://localhost:8787
VITE_GATEWAY_URL=http://localhost:8787
# engine binary the gateway supervises (Phase 1); built by `make engine-build`
TRADE_ENGINE_BIN=./engine/_build/default/bin/main.exe

# Where runtime state lives (gitignored)
TRADE_DATA_DIR=./data
